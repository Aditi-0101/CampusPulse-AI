# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
ENVIRONMENT=production
SECRET_KEY=generate_a_random_32_byte_secret_for_production_sessions

# CORS & Domain Configuration
FRONTEND_URL=https://your-frontend-service.onrender.com
# ALLOWED_ORIGINS=https://customdomain.edu,https://your-frontend.onrender.com

# Database Configuration (PostgreSQL on Render or SQLite default)
# Render Managed PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./campuspulse_dev.db

# Meko MCP Server Configuration (Backend Only - NEVER expose to frontend)
MEKO_SERVER_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=your_meko_api_key_here

# Runtime Datapacks (Strict Isolation)
MEKO_DATAPACK_FRONTDESK=318fdc74-eb15-4cf4-9be5-57b5820b3264
MEKO_DATAPACK_DISPATCH=cdb3987f-b677-495f-8d87-01999c3f9b91

# LLM Configuration
LLM_PROVIDER=mock  # Options: 'mock' (production deterministic fallback) or 'ollama'

# Staff Authentication (Format: token:staff_id:ROLE:Full Name)
DEMO_STAFF_TOKENS=staff-token-sharma-9102:staff_sharma_9102:NOC_SUPERVISOR:Vikram Sharma,staff-token-patel-4421:staff_patel_4421:CAMPUS_ADMIN:Anita Patel,staff-token-vc-9999:staff_vc_9999:VICE_CHANCELLOR:Prof. S. N. Shukla,staff-token-audit-0012:staff_audit_0012:READ_ONLY:Dr. K. R. Rao

# Student Authentication (Format: token:student_id:Full Name)
DEMO_STUDENT_TOKENS=student-token-aarav-101:stu_aarav_101:Aarav Mehta,student-token-priya-202:stu_priya_202:Priya Sharma,student-token-rohit-303:stu_rohit_303:Rohit Verma

# Frontend Environment Variable (Set in frontend Render service)
# NEXT_PUBLIC_API_BASE_URL=https://your-backend-service.onrender.com
